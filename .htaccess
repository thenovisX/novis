# ===== The Novis — configuración del servidor =====
Options -Indexes
ServerSignature Off
# La portada es index.php: index.html con los planes y precios de la base de datos (panel → Planes)
DirectoryIndex index.php index.html

# Protección temporal frente a PHP2Shell (CVE-2026-109619). Solo en LiteSpeed (Hostinger),
# para no dar error 500 en servidores que no aceptan php_flag. También está en .user.ini.
<IfModule LiteSpeed>
  php_flag session.upload_progress.enabled off
</IfModule>

# Página de error propia
ErrorDocument 404 /404.html
# Lo prohibido también muestra la página propia (sin revelar que existe)
ErrorDocument 403 /404.html

# Una sola dirección para Google: www.thenovis.com pasa a thenovis.com (evita contenido duplicado)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Las páginas públicas llevan tus datos de negocio (panel → Ajustes): se sirven a través de pagina.php
RewriteRule ^(index|aviso-legal|privacidad|condiciones|cookies|accesibilidad)\.html$ pagina.php?p=$1 [L,QSA]
RewriteRule ^gl/(index\.html)?$ pagina.php?p=gl [L,QSA]

# Un .php que no existe da la página 404 propia (y no el aviso genérico del servidor)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.php$ - [R=404,L]

# Bloquear archivos internos (repositorio Git, documentación, ejemplos)
RedirectMatch 404 /\.git
RedirectMatch 404 /\.(gitignore|htaccess|env)
RedirectMatch 404 /(README\.md|gemini-config(\.example)?\.php)$
RedirectMatch 404 (?i)^/(CLAUDE\.md|\.claude|graphify-out|legal/)

# Nunca se sirven bases de datos, claves, copias de seguridad ni registros, estén donde estén
<FilesMatch "(?i)\.(sqlite3?|db|sql|key|pem|bak|old|orig|swp|log|ini|sh|zip|tar|gz|tgz)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)^(novis-clave|novis-db|novis-instalar|gemini-config|solicitudes)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/novis-(data|clave|db|instalar)

# Sin métodos que no se usan (TRACE/TRACK reflejan las cabeceras de la petición)
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG)$ [NC]
RewriteRule ^ - [F]

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self' https://checkout.stripe.com https://billing.stripe.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Las páginas siempre se comprueban con el servidor (así los cambios se ven al momento).
# Los estilos, scripts e imágenes llevan número de versión, por eso esos sí se guardan en caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
